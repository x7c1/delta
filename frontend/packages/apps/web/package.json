{
  "name": "@delta/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:fake": "playwright test --config playwright.fake.config.ts",
    "e2e:real": "playwright test --config playwright.real.config.ts",
    "lint": "eslint . && pnpm run lint:deps",
    "lint:deps": "pnpm --dir ../../.. exec depcruise --config .dependency-cruiser.cjs packages",
    "preview": "vite preview"
  },
  "dependencies": {
    "@delta/api-client": "workspace:*",
    "@delta/model": "workspace:*",
    "@delta/ui-kit": "workspace:*",
    "@delta/wire-gen": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@delta/api-mocks": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "dependency-cruiser": "^16.8.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.0"
  }
}
